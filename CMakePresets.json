{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default build (select compiler via CMake environment)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "integration",
      "displayName": "GPU integration tests",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-integration",
      "cacheVariables": {
        "TEXUPSR_BUILD_GPU_TESTS": "ON"
      }
    },
    {
      "name": "analysis",
      "displayName": "Ninja analysis compilation database",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "unit",
      "displayName": "CPU-only unit tests",
      "inherits": "analysis",
      "binaryDir": "${sourceDir}/build-unit",
      "cacheVariables": {
        "TEXUPSR_BUILD_APP": "OFF",
        "TEXUPSR_BUILD_GPU_TESTS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "configuration": "Release"
    },
    {
      "name": "unit",
      "configurePreset": "unit",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "default",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "unit"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "configuration": "Release",
      "filter": {
        "include": {
          "label": "integration"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
