{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-analysis-local",
      "inherits": "analysis",
      "cacheVariables": {
        "OpenCV_DIR": "C:/path/to/opencv/build",
        "TensorRT_ROOT": "C:/path/to/TensorRT",
        "CUDAToolkit_ROOT": "C:/path/to/CUDA"
      }
    }
  ]
}
