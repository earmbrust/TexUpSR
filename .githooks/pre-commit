#!/bin/sh
# TexUpSR local quality gate. Enable once: git config core.hooksPath .githooks
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File tools/check.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/check.ps1
else
    echo 'PowerShell is required for the TexUpSR pre-commit quality gate.' >&2
    exit 1
fi
